# -------------------------------
# Aplikasi Genjaka - Environment
# Salin file ini menjadi .env lalu isi nilai sesuai environment.
# -------------------------------

# ---- Node / Server ----
PORT=3001
NODE_ENV=production
APP_TIME_ZONE=Asia/Jakarta

# Wajib diisi saat NODE_ENV=production (tidak boleh default 'genjaka-dev-secret').
# Generate aman: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_32_BYTE_ATAU_LEBIH_2026

# ---- Mode Data ----
# Pilih: mysql (disarankan production) | memory (hanya testing)
APP_DATA_MODE=mysql

# ---- MySQL ----
# Jika pakai docker-compose dari repo ini, DB_HOST cukup pakai "mysql" (nama service).
# Jika pakai MySQL di host luar Docker, isi IP/hostname nya.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_genjaka
DB_USER=genjaka
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_YANG_KUAT_2026

# Hanya untuk docker-compose service MySQL (bukan credential aplikasi).
DB_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_DB_2026

# ---- Publish Port (opsional, docker-compose) ----
# Port yang dibuka ke host untuk nginx (frontend + proxy API)
APP_PORT=8080
# Port backend (opsional dibuka jika butuh akses langsung; biasanya tidak perlu).
API_PORT=3001
# Port MySQL yang dibuka ke host (untuk akses dari luar jaringan Docker).
DB_PORT_PUBLISH=3307
